generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  stripeId       String?
  credits        Int           @default(100)
  workspaces     Workspace[]
  socialAccounts SocialAuth[]
}

model Workspace {
  id              String      @id @default(uuid())
  name            String      // "FORBIDDEN SECRETS" | "Finance Shorts"
  slug            String      @unique
  aspectRatio     String      @default("16:9") // "9:16" | "16:9"
  userId          String
  user            User        @relation(fields: [userId], references: [id])

  // Visual Identity (injected into Remotion CSS variables)
  colorPalette    Json        // ["#800020", "#800080", "#CC7722"]
  themeConfig     Json        // { font, bgStyle, overlayIcons[] }
  systemPrompt    String?     // "Use cinematic cyberpunk aesthetic"
  bRollPromptBase String?     // Injected into every B-roll generation request

  // Swappable AI Providers per workspace
  llmProvider     String      @default("GEMINI")      // GEMINI | OPENAI
  videoProvider   String      @default("PEXELS")      // PEXELS | GOOGLE_VEO | KLING | FAL_AI
  voiceProvider   String      @default("CARTESIA")    // CARTESIA | ELEVENLABS | DEEPGRAM

  projects        Project[]
  characters      Character[]
}

model Character {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  name          String
  baseImageUrl  String    // Supabase Storage URL — stable avatar image
  voiceProvider String    // 'ELEVENLABS' | 'CARTESIA'
  voiceModelId  String    // Provider-specific voice ID
}

model Project {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  characterId  String?
  title        String
  rawScript    String    // Full LLM-generated script text
  timelineJson Json      // Master Timeline JSON State
  status       String    @default("DRAFT") // DRAFT | RENDERING | RENDERED | PUBLISHED
  storageUrl   String?   // Permanent Supabase Storage bucket URL
  youtubeUrl   String?
  publishedAt  DateTime? // Scheduled publish time for cron
  creditsCost  Int?      // Credits deducted at render time
}

model SocialAuth {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  platform     String   // 'YOUTUBE' | 'FACEBOOK'
  accessToken  String
  refreshToken String
  expiresAt    DateTime?
}
