{
  "name": "assemblyreel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:billing": "eslint --no-ignore src/features/billing src/server/billing src/server/generation src/app/api/stripe scripts/billing tests/billing",
    "test:billing": "node --test tests/billing/*.test.mjs",
    "check:billing": "node scripts/billing/check-readiness.mjs",
    "lint:timeline": "eslint --config eslint.timeline.config.mjs src/features/timeline-editor/components/SceneClipLabel.tsx src/features/timeline-editor/components/TimelineEditor.tsx src/features/timeline-editor/components/EditorRecovery.tsx src/features/timeline-editor/interaction.ts src/features/timeline-editor/pointer-gesture.ts src/features/timeline-editor/save-queue.ts src/features/timeline-editor/validation.ts src/features/timeline-editor/playback.ts src/features/timeline-editor/use-committed-event.ts src/features/timeline-editor/components/SceneBlock.tsx src/features/timeline-editor/components/TransitionControl.tsx",
    "test:timeline": "node --test tests/timeline-editor/*.test.mjs tests/presentations/timeline.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy:remotion": "remotion lambda sites create src/remotion/index.ts --site-name=assemblyreel"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.34",
    "@ai-sdk/openai": "^4.0.59",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@deepgram/sdk": "^3.9.0",
    "@google/genai": "^2.11.0",
    "@remotion/bundler": "^4.0.506",
    "@remotion/cli": "^4.0.506",
    "@remotion/google-fonts": "4.0.506",
    "@remotion/lambda": "^4.0.506",
    "@remotion/player": "^4.0.506",
    "@remotion/renderer": "^4.0.506",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@trigger.dev/sdk": "^4.7.2",
    "ai": "^7.0.52",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-rnd": "^10.5.3",
    "remotion": "^4.0.506",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^5"
  }
}
