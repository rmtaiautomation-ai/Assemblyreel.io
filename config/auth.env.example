# Copy values into .env.local or the matching Vercel environment; never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-STAGING-PUBLIC-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ACCESS_STAGE=auth_only
# Only set true after Phase 0 containment and staging checks pass.
AUTH_LAUNCH_READY=false
# Requires migration 002, required email confirmation, and matching callback URLs.
AUTH_REGISTRATION_ENABLED=false
# Optional: durable leads require migration 002 and a server-only service-role key.
MARKETING_LEADS_ENABLED=false
# SUPABASE_SERVICE_ROLE_KEY=only-needed-if-leads-are-enabled
# Phase 3: configure the same Turnstile provider/secret in Supabase Auth.
AUTH_CAPTCHA_REQUIRED=false
AUTH_ABUSE_CONTROLS_READY=false
AUTH_RECOVERY_ENABLED=false
# Enable separately after both email-change inboxes can receive confirmations.
AUTH_EMAIL_CHANGE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# AUTH_RECOVERY_SECRET=generate-a-private-random-secret-of-at-least-32-characters
# Phases 4–6: only after remote migrations and two-account tests pass.
OWNERSHIP_MIGRATION_READY=false
OWNED_CONTENT_ENABLED=false
PRIVATE_MEDIA_ENABLED=false
PRIVATE_MEDIA_IMPORT_ENABLED=false
PRIVATE_MEDIA_IMPORT_ORIGINS=
# Private media requires the server-only service-role key, never a public key.
# Phase 7: enable only after migration 007 and deployed two-account acceptance.
ONBOARDING_ENABLED=false
# Phases 8–10: selected staging only, ordered migrations and hosted acceptance required.
BILLING_MIGRATION_READY=false
BILLING_STRIPE_MODE=test
BILLING_ENABLED=false
BILLING_SALES_ENABLED=false
BILLING_PORTAL_ENABLED=false
BILLING_WEBHOOKS_ENABLED=false
BILLING_RECONCILIATION_ENABLED=false
BILLING_INVOICES_ENABLED=false
# STRIPE_SECRET_KEY=server-only-test-key
# STRIPE_WEBHOOK_SECRET=server-only-signing-secret
JOBS_MIGRATION_READY=false
DURABLE_JOBS_ENABLED=false
MOCK_JOBS_ENABLED=false
JOB_DISPATCH_ENABLED=false
COSTLY_FEATURES_ENABLED=false
HOSTED_SCRIPT_ENABLED=false
HOSTED_SCRIPT_BOUNDS_ACCEPTED=false
CLOUD_PREVIEW_ENABLED=false
CLOUD_PREVIEW_BOUNDS_ACCEPTED=false
# REMOTION_ACCOUNT_SERVE_URL=https://<bucket>.s3.<region>.amazonaws.com/sites/account-preview-v1/index.html
# Uses explicit REMOTION_AWS_* credentials/region, REMOTION_FUNCTION_NAME and REMOTION_S3_BUCKET_NAME.
# OPENAI_API_KEY=server-only-provider-key
# TRIGGER_PROJECT_ID=selected-isolated-trigger-project
# TRIGGER_SECRET_KEY=server-only-staging-key
