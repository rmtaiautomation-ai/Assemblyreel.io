# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# generated media — now lives in Supabase Storage, not the repo.
# These were previously committed, which is the only reason the deployed app
# rendered anything: Vercel's filesystem is read-only, so nothing written at
# runtime survives. Files already on disk are kept locally as a rollback until
# a project is confirmed loading entirely from Storage URLs.
/public/audio
/public/media
