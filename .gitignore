# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# generated media — now lives in Supabase Storage, not the repo.
# These were previously committed, which is the only reason the deployed app
# rendered anything: Vercel's filesystem is read-only, so nothing written at
# runtime survives. Files already on disk are kept locally as a rollback until
# a project is confirmed loading entirely from Storage URLs.
# Written as /public/audio/* (not /public/audio) specifically so the
# transitions/ carve-out below can work — git cannot re-include a path whose
# parent directory itself matched an exclude pattern, only an excluded child
# entry, so the directory itself has to stay un-excluded here.
/public/audio/*
/public/media

# ...except bundled, build-time static assets — not generated at runtime, so
# the rollback reasoning above doesn't apply, and Vercel's read-only-filesystem
# limitation is about writes happening AFTER deploy, not files already in the
# repo at build time. Without this carve-out these ship on disk locally but
# silently vanish for anyone who clones the repo fresh or deploys it.
!/public/audio/transitions/
